# systemd 유닛 템플릿. 그대로 쓰지 말고 install.sh 로 설치할 것
# (사용자 이름과 경로를 자동으로 채워준다).
#
# 수동으로 쓰려면 __USER__ 와 __HOME__ 을 실제 값으로 바꿔서
# /etc/systemd/system/helth-bot.service 에 저장.

[Unit]
Description=혼자보는 운동 봇
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__HOME__/helth_training
ExecStart=__HOME__/helth_training/.venv/bin/python -m bot
Restart=always
RestartSec=10
User=__USER__

[Install]
WantedBy=multi-user.target
