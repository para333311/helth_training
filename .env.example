# 이 파일을 .env 로 복사해서 실제 값을 채운다. .env 는 커밋되지 않는다.
#
#   cp .env.example .env

# ─── 필수 ──────────────────────────────────────────────────────────────

# BotFather 에서 발급받은 봇 토큰.
# 노출되면 즉시 BotFather → /revoke 로 재발급할 것.
TELEGRAM_BOT_TOKEN=

# 채널 식별자.
# 공개 채널이면 @채널이름, 비공개 채널이면 -100 으로 시작하는 숫자 ID 가 필요하다.
# 숫자 ID 찾기:  python -m bot --chatid
TELEGRAM_CHANNEL_ID=

# ─── 혼자 쓰는 채널 ────────────────────────────────────────────────────

# 비공개 + 나 혼자 쓰는 채널이면 true.
# 투표처럼 여러 명을 전제로 한 기능을 끄고, 주간 결산을 내 기록 기준으로 바꾼다.
SOLO_MODE=true

# 내 텔레그램 user_id. 주간 결산에 내 스트릭을 표시하는 데 쓴다.
# 봇에게 아무 메시지나 보낸 뒤 로그를 보거나, @userinfobot 에서 확인할 수 있다.
#
# --brief / --record 가 "누구 기록인지"를 이걸로 판단한다.
# 비어 있으면 --brief 가 전부 0 으로 나온다.
OWNER_USER_ID=

# 봇 username (체크인 글에 "기록하기 → @봇" 링크로 들어간다)
TELEGRAM_BOT_USERNAME=

# ─── 자극 발행 주기 ────────────────────────────────────────────────────

# 사진/영상/명언 카드 발행 간격 (분)
PHOTO_INTERVAL_MINUTES=30

# 발행 시작·종료 시각. 이 범위 밖에서는 쉰다 (밤에는 조용).
PHOTO_START_HOUR=6
PHOTO_END_HOUR=22

# ─── 사진 소스 ─────────────────────────────────────────────────────────
#
# 우선순위: 내가 봇에 보낸 사진 → content/photos/ 폴더 → 스톡 API
# 아무것도 없으면 명언 카드로, 그것도 안 되면 텍스트로 대체된다.
#
# ⚠️ 인스타그램 등에서 남의 사진을 긁어오는 기능은 없다.
#    타인의 저작물이자 초상권이 걸린 이미지라 재게시하면 안 된다.

# 스톡 사진 API 키 (선택, 무료).
#   Unsplash: https://unsplash.com/developers  에서 앱 등록 후 Access Key
#   Pexels:   https://www.pexels.com/api/       에서 API Key
# 혼자 쓰는 채널에서 시간당 1장을 채우려면 둘 중 하나는 넣는 걸 권장한다.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# 스톡 검색어 (쉼표로 구분)
PHOTO_QUERY=home workout,gym motivation,fitness

# ─── Cloudflare D1 (선택, Render 등 재시작마다 디스크가 초기화되는 곳에서) ──
#
# 셋 다 채우면 로컬 SQLite(data/helth.db) 대신 Cloudflare D1(원격, 영구 저장)을
# 쓴다. 비워두면 기존처럼 로컬 파일을 쓴다 (라즈베리파이·Windows·로컬 개발엔 불필요).
# 설정 방법은 docs/09-render-setup.md 참고.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# ─── 하이록스 WOD (매일 18:00, 헬스장용) ───────────────────────────────
#
# 1km 달리기와 근력 스테이션을 번갈아 배치한다 (러닝 → 스테이션 → 러닝 → …).
# 이 숫자만큼 러닝·스테이션이 반복된다. 3회로 시작해서 감당되면 늘려간다.
HYROX_RUNS=3

# ─── 시즌 ──────────────────────────────────────────────────────────────

# 시즌 시작일 (YYYY-MM-DD). D+n 계산 기준. 비우면 오늘부터.
SEASON_START=

SEASON_DAYS=84
SEASON_NAME=3kg 프로젝트
GOAL_KG=3.0

# ─── 기타 ──────────────────────────────────────────────────────────────

TZ=Asia/Seoul
